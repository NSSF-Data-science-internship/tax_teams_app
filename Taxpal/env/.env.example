# This file includes environment variables that will be committed to git by default.

# Built-in environment variables
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev

# Updating AZURE_SUBSCRIPTION_ID or AZURE_RESOURCE_GROUP_NAME after provision may also require an update to RESOURCE_SUFFIX, because some services require a globally unique name across subscriptions/resource groups.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
RESOURCE_SUFFIX=

# Generated during provision, you can also add your own variables.
BOT_ID=
TEAMS_APP_ID=
TEAMS_APP_TENANT_ID=
BOT_AZURE_APP_SERVICE_RESOURCE_ID=
BOT_DOMAIN=

LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_FLOW_ID=YOUR_FLOW_ID

# Gemini — get your key from https://ai.google.dev/gemini-api
GEMINI_API_KEY=sk-your-key-here
MAX_TRUSTED_WEB_SOURCES=4
MAX_TRUSTED_DOWNLOAD_BYTES=8000000
MAX_TRUSTED_TEXT_CHARS=40000
WEB_RELEVANCE_THRESHOLD=0.35

# Hybrid GraphRAG (the indexer and query service use the same Gemini key above)
GRAPH_RAG_ENABLED=true
GRAPH_RAG_URL=http://localhost:8002
GRAPH_RAG_MODE=auto
GRAPH_RAG_TIMEOUT=180
GRAPHRAG_COMPLETION_MODEL=gemini-2.5-flash-lite
GRAPHRAG_EMBEDDING_MODEL=gemini-embedding-001

# Host-side Chroma access (containers use chroma:8000 internally)
CHROMA_HOST=127.0.0.1
CHROMA_PORT=18000

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# Qdrant — running locally via docker-compose
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tax_law_ug

# Langflow — running locally via docker-compose
LANGFLOW_API_URL=http://localhost:7860
LANGFLOW_FLOW_ID=you-will-get-this-in-step-8
