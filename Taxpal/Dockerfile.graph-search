# syntax=docker/dockerfile:1
FROM python:3.12-slim

WORKDIR /app

COPY src/requirements.graph.txt /app/requirements.graph.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 300 --retries 5 -r /app/requirements.graph.txt

COPY src/graph_rag_service.py src/graph_index.py /app/

ENV GRAPH_RAG_ROOT=/graph

CMD ["uvicorn", "graph_rag_service:app", "--host", "0.0.0.0", "--port", "8002"]
