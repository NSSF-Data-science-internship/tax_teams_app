# syntax=docker/dockerfile:1
FROM python:3.12-slim

WORKDIR /app

ENV HF_HOME=/root/.cache/huggingface

COPY src/requirements.search.txt /app/requirements.search.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 300 --retries 5 \
    --index-url https://download.pytorch.org/whl/cpu torch && \
    pip install --timeout 300 --retries 5 \
    -r /app/requirements.search.txt

COPY src/ /app/
COPY data/chunks/all_chunks.json /data/chunks/all_chunks.json

CMD ["sh", "-c", "uvicorn tax_search_api:app --host 0.0.0.0 --port ${PORT:-8001}"]
