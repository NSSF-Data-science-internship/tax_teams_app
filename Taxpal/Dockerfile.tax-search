FROM python:3.12-slim

WORKDIR /app

ENV HF_HOME=/root/.cache/huggingface

COPY src/requirements.search.txt /app/requirements.search.txt

RUN pip install --no-cache-dir --timeout 300 --retries 5 \
    --index-url https://download.pytorch.org/whl/cpu torch
RUN pip install --no-cache-dir --timeout 300 --retries 5 \
    -r /app/requirements.search.txt

COPY src/ /app/
COPY data/chunks/all_chunks.json /data/chunks/all_chunks.json

CMD ["uvicorn", "tax_search_api:app", "--host", "0.0.0.0", "--port", "8001"]
